<Window x:Class="MacDock.Finder.FinderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="clr-namespace:MacDock"
        xmlns:local="clr-namespace:MacDock.Finder"
        Title="Finder" Width="980" Height="600" MinWidth="560" MinHeight="340"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResize"
        FontFamily="{x:Static md:MacFonts.Text}" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="18" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Palette (light, macOS Sonoma). Replaced in code for dark mode. -->
        <SolidColorBrush x:Key="ContentBg" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="SidebarBg" Color="#FFEDECF1"/>
        <SolidColorBrush x:Key="Text" Color="#FF1D1D1F"/>
        <SolidColorBrush x:Key="SubText" Color="#FF86868B"/>
        <SolidColorBrush x:Key="SectionText" Color="#FF8E8E93"/>
        <SolidColorBrush x:Key="Accent" Color="#FF0A6CFF"/>
        <SolidColorBrush x:Key="SidebarGlyph" Color="#FF1F7CF5"/>
        <SolidColorBrush x:Key="SelectionInactiveBg" Color="#FFDCDCE0"/>
        <SolidColorBrush x:Key="IconSelBg" Color="#FFE3E3E8"/>
        <SolidColorBrush x:Key="SidebarSel" Color="#FFD8D7DD"/>
        <SolidColorBrush x:Key="Stripe" Color="#FFF4F5F5"/>
        <SolidColorBrush x:Key="Separator" Color="#FFE3E3E3"/>
        <SolidColorBrush x:Key="FrameBorder" Color="#38000000"/>
        <SolidColorBrush x:Key="ControlBg" Color="#FFE9E9EE"/>
        <SolidColorBrush x:Key="ControlSel" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="HoverBg" Color="#14000000"/>
        <SolidColorBrush x:Key="ScrollThumb" Color="#55000000"/>
        <SolidColorBrush x:Key="RenameBg" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="LightInactive" Color="#FFD2D2D6"/>
        <SolidColorBrush x:Key="DropTarget" Color="#330A6CFF"/>
        <!-- Liquid Glass -->
        <SolidColorBrush x:Key="SidebarGlass" Color="#B4F2F2F6"/>
        <SolidColorBrush x:Key="GlassFill" Color="#F2FFFFFF"/>
        <SolidColorBrush x:Key="GlassSegSel" Color="#16000000"/>
        <LinearGradientBrush x:Key="GlassRim" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFFFFF" Offset="0"/>
            <GradientStop Color="#33FFFFFF" Offset="0.5"/>
            <GradientStop Color="#1F000000" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="GlassCapsule" TargetType="Border">
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="3,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource GlassFill}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlassRim}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.16" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slim, macOS-like scroll bars -->
        <Style x:Key="SlimThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border CornerRadius="3.5" Background="{DynamicResource ScrollThumb}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="11"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
                                    <Track.Thumb><Thumb Style="{StaticResource SlimThumb}" Margin="2,2,2,2"/></Track.Thumb>
                                </Track>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="11"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
                                    <Track.Thumb><Thumb Style="{StaticResource SlimThumb}" Margin="2,2,2,2"/></Track.Thumb>
                                </Track>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Toolbar buttons: plain symbol, soft rounded hover -->
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented view switcher -->
        <Style x:Key="SegButton" TargetType="RadioButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Foreground" Value="{DynamicResource SubText}"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="GroupName" Value="View"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource GlassSegSel}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FinderList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="SelectionMode" Value="Extended"/>
            <Setter Property="TextSearch.TextPath" Value="Name"/>
            <Setter Property="AllowDrop" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ScrollViewer x:Name="Scroller" Focusable="False" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"
                                      CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                      HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                      VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- In-place rename box -->
        <Style x:Key="RenameBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource RenameBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="1,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>

        <!-- ===== Icon view ===== -->
        <Style x:Key="IconItem" TargetType="ListBoxItem">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="Transparent" Padding="2">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="IconTemplate" DataType="{x:Type local:FileEntry}">
            <StackPanel x:Name="Root" Width="100" Margin="2,4,2,6">
                <Border x:Name="IconBg" Width="78" Height="74" CornerRadius="7" HorizontalAlignment="Center">
                    <Image Source="{Binding Icon}" Width="64" Height="64" RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform"/>
                </Border>
                <Grid HorizontalAlignment="Center" Margin="0,3,0,0">
                    <Border x:Name="NameBg" CornerRadius="4" Padding="5,1,5,2" HorizontalAlignment="Center">
                        <TextBlock x:Name="NameText" Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                   MaxHeight="34" MaxWidth="94" FontSize="12" Foreground="{DynamicResource Text}"/>
                    </Border>
                    <TextBox x:Name="Rename" Style="{StaticResource RenameBox}" Width="98" TextWrapping="Wrap" TextAlignment="Center"
                             Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                             IsVisibleChanged="RenameBox_IsVisibleChanged" PreviewKeyDown="RenameBox_KeyDown" LostKeyboardFocus="RenameBox_LostFocus"/>
                </Grid>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="IconBg" Property="Background" Value="{DynamicResource IconSelBg}"/>
                    <Setter TargetName="NameBg" Property="Background" Value="{DynamicResource SelectionInactiveBg}"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/>
                        <Condition Binding="{Binding (Selector.IsSelectionActive), RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="NameBg" Property="Background" Value="{DynamicResource Accent}"/>
                    <Setter TargetName="NameText" Property="Foreground" Value="White"/>
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding IsHidden}" Value="True">
                    <Setter TargetName="Root" Property="Opacity" Value="0.55"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCut}" Value="True">
                    <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                    <Setter TargetName="Rename" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="NameBg" Property="Visibility" Value="Hidden"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ===== List view ===== -->
        <Style x:Key="ListItem" TargetType="ListBoxItem">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="Stripe" Background="Transparent"/>
                            <Border x:Name="Sel" Background="Transparent" CornerRadius="5" Margin="8,0"/>
                            <ContentPresenter Margin="8,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                <Setter TargetName="Stripe" Property="Background" Value="{DynamicResource Stripe}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Sel" Property="Background" Value="{DynamicResource SelectionInactiveBg}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="Selector.IsSelectionActive" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Sel" Property="Background" Value="{DynamicResource Accent}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="ListTemplate" DataType="{x:Type local:FileEntry}">
            <Grid x:Name="Root" Height="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="150"/>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>
                <Grid Margin="8,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Image Source="{Binding Icon}" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                    <TextBlock x:Name="NameText" Grid.Column="1" Text="{Binding Name}" Margin="7,0,0,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Text}"/>
                    <TextBox x:Name="Rename" Grid.Column="1" Style="{StaticResource RenameBox}" Margin="4,0,0,0" VerticalAlignment="Center" FontSize="13"
                             Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                             IsVisibleChanged="RenameBox_IsVisibleChanged" PreviewKeyDown="RenameBox_KeyDown" LostKeyboardFocus="RenameBox_LostFocus"/>
                </Grid>
                <TextBlock x:Name="DateText" Grid.Column="1" Text="{Binding DateText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SubText}"/>
                <TextBlock x:Name="SizeText" Grid.Column="2" Text="{Binding SizeText}" VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,18,0" Foreground="{DynamicResource SubText}"/>
                <TextBlock x:Name="KindText" Grid.Column="3" Text="{Binding Kind}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SubText}"/>
            </Grid>
            <DataTemplate.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/>
                        <Condition Binding="{Binding (Selector.IsSelectionActive), RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="NameText" Property="Foreground" Value="White"/>
                    <Setter TargetName="DateText" Property="Foreground" Value="White"/>
                    <Setter TargetName="SizeText" Property="Foreground" Value="White"/>
                    <Setter TargetName="KindText" Property="Foreground" Value="White"/>
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding IsHidden}" Value="True">
                    <Setter TargetName="Root" Property="Opacity" Value="0.55"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCut}" Value="True">
                    <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                    <Setter TargetName="Rename" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="NameText" Property="Visibility" Value="Hidden"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ===== Column view ===== -->
        <Style x:Key="ColumnItem" TargetType="ListBoxItem">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Sel" Background="Transparent" CornerRadius="5" Margin="6,0">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Sel" Property="Background" Value="{DynamicResource SelectionInactiveBg}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="Selector.IsSelectionActive" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Sel" Property="Background" Value="{DynamicResource Accent}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="ColumnTemplate" DataType="{x:Type local:FileEntry}">
            <Grid x:Name="Root" Height="22" Margin="6,0,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image Source="{Binding Icon}" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                <TextBlock x:Name="NameText" Grid.Column="1" Text="{Binding Name}" Margin="7,0,6,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Text}"/>
                <TextBox x:Name="Rename" Grid.Column="1" Style="{StaticResource RenameBox}" Margin="4,0,4,0" VerticalAlignment="Center" FontSize="13"
                         Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                         IsVisibleChanged="RenameBox_IsVisibleChanged" PreviewKeyDown="RenameBox_KeyDown" LostKeyboardFocus="RenameBox_LostFocus"/>
                <TextBlock x:Name="Chevron" Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9"
                           VerticalAlignment="Center" Foreground="{DynamicResource SubText}" Visibility="Collapsed"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                    <Setter TargetName="Chevron" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/>
                        <Condition Binding="{Binding (Selector.IsSelectionActive), RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="NameText" Property="Foreground" Value="White"/>
                    <Setter TargetName="Chevron" Property="Foreground" Value="White"/>
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding IsHidden}" Value="True">
                    <Setter TargetName="Root" Property="Opacity" Value="0.55"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCut}" Value="True">
                    <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                    <Setter TargetName="Rename" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="NameText" Property="Visibility" Value="Hidden"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Traffic light -->
        <Style x:Key="Light" TargetType="Ellipse">
            <Setter Property="Width" Value="13"/>
            <Setter Property="Height" Value="13"/>
            <Setter Property="StrokeThickness" Value="0.6"/>
        </Style>
        <Style x:Key="LightGlyph" TargetType="Path">
            <Setter Property="Stroke" Value="#99000000"/>
            <Setter Property="StrokeThickness" Value="1.2"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Visibility" Value="Hidden"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="Outer" Margin="16">
        <!-- Shadow on its own layer (scrolling never re-renders the blur); its host is clipped so no
             shadow falls inside the frosted sidebar. -->
        <Grid x:Name="ShadowHost">
            <Border x:Name="ShadowLayer" CornerRadius="18" Background="{DynamicResource ContentBg}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="34" ShadowDepth="10" Direction="270" Opacity="0.34" Color="Black"/>
                </Border.Effect>
            </Border>
        </Grid>

        <Border x:Name="Frame" CornerRadius="18" Background="{x:Null}">
            <Grid x:Name="Body">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SidebarColumn" Width="216" MinWidth="170" MaxWidth="330"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Window background around the floating sidebar (the sidebar itself is see-through glass). -->
                <Path x:Name="SidebarRing" Fill="{DynamicResource ContentBg}" IsHitTestVisible="False"/>

                <!-- ===== Sidebar: a floating Liquid Glass panel ===== -->
                <Border x:Name="SidebarPanel" Margin="9,9,5,9" CornerRadius="16" Background="{DynamicResource SidebarGlass}"
                        BorderBrush="{DynamicResource GlassRim}" BorderThickness="1">
                    <DockPanel>
                        <Border x:Name="SidebarTop" DockPanel.Dock="Top" Height="50" Background="Transparent" MouseLeftButtonDown="TitleArea_MouseDown">
                            <StackPanel x:Name="Lights" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                        Background="Transparent" MouseEnter="Lights_MouseEnter" MouseLeave="Lights_MouseLeave">
                                <Grid x:Name="CloseLight" Margin="0,0,9,0" Cursor="Arrow" MouseLeftButtonDown="Light_MouseDown" MouseLeftButtonUp="CloseLight_Click" ToolTip="Close">
                                    <Ellipse x:Name="CloseDot" Style="{StaticResource Light}" Fill="#FFFF5F57" Stroke="#FFE14640"/>
                                    <Path x:Name="CloseGlyph" Style="{StaticResource LightGlyph}" Data="M 0,0 L 5,5 M 5,0 L 0,5"/>
                                </Grid>
                                <Grid x:Name="MinLight" Margin="0,0,9,0" Cursor="Arrow" MouseLeftButtonDown="Light_MouseDown" MouseLeftButtonUp="MinLight_Click" ToolTip="Minimize">
                                    <Ellipse x:Name="MinDot" Style="{StaticResource Light}" Fill="#FFFEBC2E" Stroke="#FFDFA023"/>
                                    <Path x:Name="MinGlyph" Style="{StaticResource LightGlyph}" Data="M 0,0 L 6,0"/>
                                </Grid>
                                <Grid x:Name="ZoomLight" Cursor="Arrow" MouseLeftButtonDown="Light_MouseDown" MouseLeftButtonUp="ZoomLight_Click" ToolTip="Zoom">
                                    <Ellipse x:Name="ZoomDot" Style="{StaticResource Light}" Fill="#FF28C840" Stroke="#FF1DAD2C"/>
                                    <Path x:Name="ZoomGlyph" Style="{StaticResource LightGlyph}" Stroke="{x:Null}" Fill="#99000000"
                                          Data="M 0,0 L 4,0 L 0,4 Z M 6,6 L 2,6 L 6,2 Z"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <StackPanel x:Name="SidebarHost" Margin="0,0,0,12"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
                <GridSplitter Grid.Column="0" Width="5" HorizontalAlignment="Right" Background="Transparent" Focusable="False" Cursor="SizeWE"/>

                <!-- ===== Main area ===== -->
                <Grid Grid.Column="1" Background="{DynamicResource ContentBg}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="60"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Toolbar: floating glass capsules, no bar behind them -->
                    <Border x:Name="Toolbar" Background="Transparent" MouseLeftButtonDown="TitleArea_MouseDown">
                        <DockPanel Margin="8,0,14,0" LastChildFill="True">
                            <Border DockPanel.Dock="Left" Style="{StaticResource GlassCapsule}">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="BackButton" Style="{StaticResource ToolButton}" Content="&#xE76B;" Click="Back_Click" ToolTip="Back" FontSize="13"/>
                                    <Button x:Name="ForwardButton" Style="{StaticResource ToolButton}" Content="&#xE76C;" Click="Forward_Click" ToolTip="Forward" FontSize="13"/>
                                </StackPanel>
                            </Border>

                            <!-- Search capsule (right) -->
                            <Border DockPanel.Dock="Right" x:Name="SearchField" Style="{StaticResource GlassCapsule}" Width="190" Margin="8,0,0,0" Padding="12,0,6,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource SubText}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SearchPlaceholder" Grid.Column="1" Text="Search" Margin="8,0,0,1" Foreground="{DynamicResource SubText}" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                    <TextBox x:Name="SearchBox" Grid.Column="1" Margin="5,0,0,0" Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                                             Foreground="{DynamicResource Text}" CaretBrush="{DynamicResource Text}" FocusVisualStyle="{x:Null}"
                                             TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_KeyDown" LostKeyboardFocus="SearchBox_LostFocus"/>
                                    <Button x:Name="SearchClear" Grid.Column="2" Style="{StaticResource ToolButton}" Width="20" Height="20" FontSize="9" Content="&#xE894;"
                                            Click="SearchClear_Click" Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <Button x:Name="SearchButton" DockPanel.Dock="Right" Visibility="Collapsed" Click="SearchButton_Click"/>

                            <Border DockPanel.Dock="Right" Style="{StaticResource GlassCapsule}" Margin="8,0,0,0">
                                <Button x:Name="ActionButton" Style="{StaticResource ToolButton}" Content="&#xE712;" Click="ActionButton_Click" ToolTip="Actions"/>
                            </Border>
                            <Border DockPanel.Dock="Right" Style="{StaticResource GlassCapsule}" Margin="8,0,0,0">
                                <Button x:Name="SortButton" Style="{StaticResource ToolButton}" Click="SortButton_Click" ToolTip="Sort By" Width="46">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8CB;" FontSize="14"/>
                                        <TextBlock Text="&#xE70D;" FontSize="7" Margin="4,2,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Border>

                            <!-- View switcher capsule -->
                            <Border DockPanel.Dock="Right" Style="{StaticResource GlassCapsule}" Margin="8,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="IconViewButton" Style="{StaticResource SegButton}" Checked="ViewButton_Checked" ToolTip="as Icons">
                                        <Path Data="M0,0 H5 V5 H0 Z M8,0 H13 V5 H8 Z M0,8 H5 V13 H0 Z M8,8 H13 V13 H8 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                    </RadioButton>
                                    <RadioButton x:Name="ListViewButton" Style="{StaticResource SegButton}" Checked="ViewButton_Checked" ToolTip="as List">
                                        <Path Data="M0,0 H2 V2 H0 Z M4,0 H14 V2 H4 Z M0,5 H2 V7 H0 Z M4,5 H14 V7 H4 Z M0,10 H2 V12 H0 Z M4,10 H14 V12 H4 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                    </RadioButton>
                                    <RadioButton x:Name="ColumnViewButton" Style="{StaticResource SegButton}" Checked="ViewButton_Checked" ToolTip="as Columns">
                                        <Path Data="M0.5,0.5 H14.5 V12.5 H0.5 Z M5.2,0.5 V12.5 M9.8,0.5 V12.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.2"/>
                                    </RadioButton>
                                </StackPanel>
                            </Border>

                            <TextBlock x:Name="TitleText" Margin="14,0,12,0" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </Border>

                    <!-- Content -->
                    <Grid Grid.Row="1" x:Name="ContentHost" Background="{DynamicResource ContentBg}">
                        <ListBox x:Name="IconList" Style="{StaticResource FinderList}" Padding="10,4,8,10"
                                 ItemContainerStyle="{StaticResource IconItem}" ItemTemplate="{StaticResource IconTemplate}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>

                        <DockPanel x:Name="ListHost" Visibility="Collapsed">
                            <Border DockPanel.Dock="Top" Height="28" BorderBrush="{DynamicResource Separator}" BorderThickness="0,0,0,1" Padding="8,0,19,0">
                                <Grid x:Name="ListHeader">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="150"/>
                                        <ColumnDefinition Width="190"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="160"/>
                                    </Grid.ColumnDefinitions>
                                </Grid>
                            </Border>
                            <ListBox x:Name="DetailList" Style="{StaticResource FinderList}" Padding="0,4,0,8" AlternationCount="2"
                                     ItemContainerStyle="{StaticResource ListItem}" ItemTemplate="{StaticResource ListTemplate}"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Visible"/>
                        </DockPanel>

                        <ScrollViewer x:Name="ColumnScroller" Visibility="Collapsed" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False">
                            <StackPanel x:Name="ColumnsHost" Orientation="Horizontal"/>
                        </ScrollViewer>

                        <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SubText}"
                                   FontSize="13" Visibility="Collapsed" IsHitTestVisible="False"/>
                    </Grid>

                    <!-- Path bar -->
                    <Border Grid.Row="2" x:Name="PathBarHost" Height="26" BorderBrush="{DynamicResource Separator}" BorderThickness="0,1,0,0" Background="{DynamicResource ContentBg}">
                        <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Focusable="False">
                            <StackPanel x:Name="PathBar" Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center"/>
                        </ScrollViewer>
                    </Border>

                    <!-- Status bar -->
                    <Border Grid.Row="3" Height="24" BorderBrush="{DynamicResource Separator}" BorderThickness="0,1,0,0" Background="{DynamicResource ContentBg}">
                        <TextBlock x:Name="StatusText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource SubText}"/>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <Border x:Name="FrameRim" CornerRadius="18" BorderThickness="1" BorderBrush="{DynamicResource FrameBorder}" IsHitTestVisible="False"/>
    </Grid>
</Window>
